# Configure estas variáveis no ambiente do processo (este arquivo não é carregado automaticamente).
CONTRACT_SOURCE=api
CONTRATOS_API_URL=
CONTRATOS_API_TOKEN=
FLASK_SECRET_KEY=
HIPER_DRY_RUN=true
# Banco em disco persistente; caminho absoluto recomendado em produção.
DATABASE_PATH=
# Timeout do download do certificado (padrão: 60 segundos; API do contrato: 10).
CERTIFICATE_TIMEOUT_SECONDS=60

# API moderna: GET {CONTRACT_API_URL}/{id}. Tem precedência sobre a API legada.
CONTRACT_API_URL=
CONTRACT_API_TOKEN=
REAL_HIPER_AUTOMATION_ENABLED=false
HIPER_BROWSER_HEADLESS=false
HIPER_BROWSER_TIMEOUT_MS=30000
HIPER_STORAGE_STATE_DIR=./data/hiper-sessions
HIPER_SCREENSHOT_DIR=./data/hiper-artifacts
# JSON capturado da interface autorizada; vazio bloqueia navegação/alterações.
HIPER_SELECTOR_PROFILE=
HIPER_DEFAULT_DOMAIN=
HIPER_DEBUG=false
# Uso em rede exige autenticação/TLS no proxy e secret forte.
HIPER_TRUSTED_HOSTS=localhost,127.0.0.1
